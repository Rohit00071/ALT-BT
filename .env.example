# ================================================
# AI-Powered Manim Animator — Environment Config
# All providers are FREE-TIER ONLY for hackathon usage
# ================================================

# LLM Provider: "gemini" or "groq"
LLM_PROVIDER=gemini

# Google Gemini (free tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.0-flash

# Groq (free tier, no credit card required)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Rendering
VIDEO_OUTPUT_DIR=./videos
TEMP_SCENE_DIR=./tmp_scenes

# Font for non-Latin scripts (must be installed on system)
NON_LATIN_FONT_NAME=Noto Sans
